@host = http://localhost:3000/api
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiIxIiwiaWF0IjoxNzczMTUwNDgyLCJleHAiOjE3NzMxNTQwODJ9.b3K-y1-RWRO4ep3gi5olEHObw6M9ZF5eGfJA5CfHXrI
@userId = 1
@friendId = 2
@recipeId = 1
@calendarEntryId = 1
@notificationId = 1

### Authentication - Register User
POST {{host}}/auth/register
Content-Type: application/json

{
  "name": "Test User",
  "email": "test@example.com",
  "password": "TestPassword123!"
}

### Authentication - Login User
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "TestPassword123!"
}

### Users - Get Current User Profile
GET {{host}}/users/me
Authorization: Bearer {{token}}

### Users - Update Current User Profile
PUT {{host}}/users/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Updated Test User",
  "profilePicture": "https://example.com/new_pic.jpg"
}

### Friends - Get User's Friends
GET {{host}}/users/me/friends
Authorization: Bearer {{token}}

### Friends - Add a Friend
POST {{host}}/users/me/friends
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "friendId": {{friendId}}
}

### Friends - Delete a Friend
DELETE {{host}}/users/me/friends/{{friendId}}
Authorization: Bearer {{token}}

### Recipes - Get All Recipes
GET {{host}}/recipes
Authorization: Bearer {{token}}

### Recipes - Get All Recipes with Search
GET {{host}}/recipes?search=pasta
Authorization: Bearer {{token}}

### Recipes - Get Single Recipe by ID
GET {{host}}/recipes/{{recipeId}}
Authorization: Bearer {{token}}

### Favorite Foods - Get User's Favorite Recipes
GET {{host}}/users/me/favorites
Authorization: Bearer {{token}}

### Favorite Foods - Add a Recipe to Favorites
POST {{host}}/users/me/favorites
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "recipeId": {{recipeId}}
}

### Favorite Foods - Delete a Recipe from Favorites
DELETE {{host}}/users/me/favorites/{{recipeId}}
Authorization: Bearer {{token}}

### Calendar Entries - Get User's Calendar Entries
GET {{host}}/users/me/calendar?startDate=2023-01-01&endDate=2023-12-31
Authorization: Bearer {{token}}

### Calendar Entries - Add a Calendar Entry
POST {{host}}/users/me/calendar
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "recipeId": {{recipeId}},
  "date": "2023-10-27T12:00:00Z"
}

### Calendar Entries - Delete a Calendar Entry
DELETE {{host}}/users/me/calendar/{{calendarEntryId}}
Authorization: Bearer {{token}}

### Notifications - Get User's Notifications
GET {{host}}/users/me/notifications
Authorization: Bearer {{token}}

### Notifications - Mark a Notification as Read
PUT {{host}}/users/me/notifications/{{notificationId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isRead": true
}